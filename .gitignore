# --- Local-only report sources and scratch files (kept off GitHub) ---
*.tex
*.zip
dbg_*.m
capture_*.m
capture_*.png
# Throwaway diagnostic probes. They are written to reproduce one measurement,
# are referenced by name in defect records, and are never part of the delivered
# code. Ignoring them keeps `git status` readable during an investigation.
# Files already tracked (docs/probes/, legacy/) are unaffected by this rule.
*_tmp.m
*_tmp.txt
chk_*.log
chk_prog.txt
context.md
kundur_ex126_update*/
kundur_ex126_update.zip
output/gui_capture/
/output/*
!output/validation/
output/validation/*
!output/validation/artifacts/
output/validation/artifacts/*
!output/validation/artifacts/*.md

# Keep repo lean: code (.m) and docs (.md) only on GitHub.
# Reference PDFs, extracted page images, fonts, local scratch and
# compiled report artefacts stay on the local machine only.
*.pdf
*.png
*.docx
*.ttf
# Extracted full text of published books and papers. These are kept locally as a
# searchable index for equation tracing, but they are third-party copyrighted
# material and must not be redistributed from a public repository. The folder
# README files stay tracked and remain the citation index.
docs/text/**/*.txt
docs/text/*.txt
# Stray working folder of empty placeholder files that was committed by accident.
docs/text/กลับห้อง*/
tmp/
tmp_ieee_busdata/
.claude/settings.local.json
docs/source/fonts/

# EXCEPTIONS: keep our own generated report assets (tex/pdf/png) tracked.
# Book/reference PDFs in docs/ stay ignored (copyrighted).
!docs/source/**/*.tex
!docs/source/**/*.pdf
!docs/source/**/*.png
!docs/page-*.png
# README presentation figures: the README is unreadable without them, and they
# are generated by scripts/reporting/generate_readme_chronology_figure.m from a
# stored run, so they can always be rebuilt.
!docs/figures/*.png

# LaTeX build artefacts and MATLAB generated data
*.aux
*.log
*.toc
*.out
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
.aider*

# Generated MATLAB data artifacts (reproducible from report generators)
*.mat
