LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
MAX_TOKENS=4096
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Authentication — set to enable Bearer token auth (leave empty for dev mode)
API_AUTH_TOKEN=

# Rate limiting (active only when API_AUTH_TOKEN is set)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SEC=60

# Retry settings
MAX_RETRIES=3
RETRY_DELAY=1.0
RETRY_BACKOFF=2.0

# Input validation limits
MAX_INPUT_LENGTH=10000
MAX_BUS_DATA_ITEMS=500
