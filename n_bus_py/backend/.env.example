# ==========================================
# N-Bus Power Flow - Configuration Example
# ==========================================

# ── AI API Keys ─────────────────────────────────────────────

# 1. สำหรับ Google Gemini (ระบบ Import Data จะบังคับใช้อันนี้)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. สำหรับโมเดลตระกูล Mercury
MERCURY_API_KEY=your_mercury_api_key_here
MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1

# 3. สำหรับโมเดลตระกูล DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 4. สำหรับ NVIDIA NIM (Chat + Import + OCR)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# โมเดลเริ่มต้นเมื่อเปิดแชท (AI Analyze)
LLM_MODEL=gemini-3.3-flash
# OCR สำหรับอ่านภาพ (Nemotron vision model)
OCR_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# โมเดลสำหรับแปลงข้อความเป็น JSON (import_case)
IMPORT_MODEL=openai/gpt-oss-120b
MAX_TOKENS=4096

# ── Server ──────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nbus

# ── Auth (JWT) ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOW_SELF_REGISTRATION=true

# Legacy token auth (leave empty to use JWT only)
API_AUTH_TOKEN=

# ── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SEC=60

# ── Retry ───────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAY=1.0
RETRY_BACKOFF=2.0

# ── Input validation ────────────────────────────────────────
MAX_INPUT_LENGTH=10000
MAX_BUS_DATA_ITEMS=500
